# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/gulfmarketwire_cms"
PORT=4000
NODE_ENV=development
SESSION_SECRET="a-long-random-string-at-least-16-chars"
ADMIN_EMAIL="admin@example.com"
# Admin password: set ONE of the two lines below.
# On servers use the hash: run  npm run hash-password -- 'your-long-password'
# and paste the line it prints (keep the single quotes).
ADMIN_PASSWORD_HASH=''
# Local development only:
ADMIN_PASSWORD="change-me-locally"
# Public address of this CMS (used for image URLs and edit links)
PUBLIC_BASE_URL="http://localhost:4000"

# Automated news task (see README "Automated news ingest")
# Shared secret, 32+ characters. Must match the key in the scheduled task.
INGEST_API_KEY=""
# Free key from https://www.pexels.com/api/
PEXELS_API_KEY=""
