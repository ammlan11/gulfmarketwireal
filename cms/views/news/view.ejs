<div class="heading"><div><a class="back" href="/admin/news">← Dashboard</a><h1><%= article.title %></h1><p class="muted"><%= article.source %> · <%= article.publishedAt.toLocaleString() %></p></div><div class="heading-actions"><% if (article.status === 'DRAFT') { %><form action="/admin/news/<%= article.id %>/status" method="post"><input type="hidden" name="status" value="PUBLISHED"><input type="hidden" name="returnTo" value="/admin/news/<%= article.id %>"><button class="publish-btn large">Publish</button></form><% } else { %><form action="/admin/news/<%= article.id %>/status" method="post"><input type="hidden" name="status" value="DRAFT"><input type="hidden" name="returnTo" value="/admin/news/<%= article.id %>"><button>Move to draft</button></form><% } %><a class="button primary" href="/admin/news/<%= article.id %>/edit">Edit</a></div></div>
<article class="card article"><div class="meta"><span class="tag"><%= article.category || '—' %></span><span class="status <%= article.status.toLowerCase() %>"><%= article.status %></span><% if (article.isTopStory) { %><span class="status topstory">Top story</span><% } %></div><% if(article.imageUrl){ %><img class="hero" src="<%= article.imageUrl %>" alt=""><% } %><h2>Description</h2><p><%= article.description || '—' %></p><h2>Content</h2><div class="content"><%= article.content || '—' %></div><dl><dt>ID</dt><dd><code><%= article.id %></code></dd><dt>Article URL</dt><dd><a target="_blank" rel="noreferrer" href="<%= article.url %>"><%= article.url %></a></dd><dt>Source URL</dt><dd><%= article.sourceUrl || '—' %></dd></dl></article>
