<div class="heading"><div><h1>News dashboard</h1><p class="muted">Create, edit, view and remove articles served by your API.</p></div><a class="button primary" href="/admin/news/new">+ Add news</a></div>
<form class="filters card" method="get"><input name="q" value="<%= q %>" placeholder="Search title, content or source"><select name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option <%= category===c?'selected':'' %>><%= c %></option><% }) %></select><select name="status"><option value="">All statuses</option><option value="DRAFT" <%= status==='DRAFT'?'selected':'' %>>Draft</option><option value="PUBLISHED" <%= status==='PUBLISHED'?'selected':'' %>>Published</option></select><button>Filter</button></form>
<div class="card tablewrap"><table><thead><tr><th>Title</th><th>Category</th><th>Status</th><th>Published</th><th>Actions</th></tr></thead><tbody><% if(!articles.length){ %><tr><td colspan="5" class="empty">No articles found.</td></tr><% } %><% articles.forEach(a=>{ %><tr><td><% if (a.isTopStory) { %><span class="status topstory">Top story</span> <% } %><strong><%= a.title %></strong><small><%= a.source %></small></td><td><span class="tag"><%= a.category || '—' %></span></td><td><span class="status <%= a.status.toLowerCase() %>"><%= a.status %></span></td><td><%= a.publishedAt.toLocaleString() %></td><td class="actions"><% if (a.status === 'DRAFT') { %><form action="/admin/news/<%= a.id %>/status" method="post"><input type="hidden" name="status" value="PUBLISHED"><input type="hidden" name="returnTo" value="<%= returnTo %>"><button class="publish-btn" title="Publish this article on the website">Publish</button></form><% } else { %><form action="/admin/news/<%= a.id %>/status" method="post"><input type="hidden" name="status" value="DRAFT"><input type="hidden" name="returnTo" value="<%= returnTo %>"><button class="unpublish-link" title="Take this article off the website">Move to draft</button></form><% } %><a href="/admin/news/<%= a.id %>">View</a><a href="/admin/news/<%= a.id %>/edit">Edit</a><form action="/admin/news/<%= a.id %>/delete" method="post" data-confirm="Delete this article?"><button class="danger-link">Delete</button></form></td></tr><% }) %></tbody></table></div>
