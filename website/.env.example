# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/gulfmarketwire_site"
# Address of the CMS whose public API supplies articles
NEWS_API_URL="http://localhost:4000"
# Ticker / market data API (leave blank locally to show "Market data temporarily unavailable")
MARKET_API_BASE_URL=""
# Public address of the website (SEO tags, sitemap, form protection)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Only for docker-compose.yml (database container passwords). Use long random values.
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
# Shared secret the CMS uses to refresh the site instantly after a publish or
# Top Story change (POST /api/revalidate). 32+ random characters; must match
# WEBSITE_REVALIDATE_SECRET in the CMS .env. Leave blank to switch it off.
REVALIDATE_SECRET=""
